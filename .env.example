# Copy to .env for docker compose / local runs. NEVER commit the real .env.
# Generate secrets with:  openssl rand -base64 48

# ---- Database (Java uses JDBC form; the worker uses the postgresql:// form) ----
DB_URL=jdbc:postgresql://localhost:5432/fleet
DB_USERNAME=fleet
DB_PASSWORD=change-me
DB_POOL_SIZE=10
WORKER_DATABASE_URL=postgresql://fleet:change-me@localhost:5432/fleet
# Worker hosted as a (free) web service: open a health port; the API pings WORKER_WAKE_URL to wake it when a file is queued.
WORKER_HEALTH_PORT=
WORKER_WAKE_URL=

# ---- Security ----
# At least 32 characters. Changing it signs everyone out.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_TTL_MINUTES=480
# Frontend origins allowed to call the API (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=600

# First administrator, created only when the users table is empty. Change the password after first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# ---- Private file storage ----
# local: a directory shared by the API and the worker (Docker volume)
# s3:    any S3-compatible private bucket (Supabase Storage S3 endpoint, AWS S3, Cloudflare R2)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/files
S3_BUCKET=fleet-files
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Misc ----
MAX_UPLOAD_MB=50
# Nightly alert run (Spring cron, Asia/Kolkata)
ALERTS_CRON=0 30 1 * * *
